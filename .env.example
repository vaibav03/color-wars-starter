# Copy this file to .env and put your Miro token after MIRO_TOKEN=, then run: python3 bot.py --login
# The server checks the token with Miro, gives you a player key, and bot.py saves it here as PLAYER_KEY.
# .env stays on your computer: git ignores it, and bot.py never prints the token or the key.
MIRO_TOKEN=
PLAYER_KEY=
